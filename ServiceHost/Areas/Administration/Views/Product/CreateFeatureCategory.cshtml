@model Eshop.Domain.Dtos.ProductFeaturesCategory.CreateProductFeaturesCategoryDto

@{
	ViewData["Title"] = " دسته بندی ویژگی محصول ";
}


@section scripts
{
	<partial name="_AdminJqueryValidators" />

}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header"><i class="fa fa-plus"></i> @ViewData["Title"]</div>
            <div class="card-body">

                <form asp-area="Administration" asp-controller="Product" asp-action="CreateFeatureCategory" method="post">
                    <div class="row">
                    <div class="form-group col-lg-6">
	                    <label>عنوان دسته ویژگی</label>
	                    <input class="form-control" asp-for="FeatureCategoryTitle" />
	                    <span class="text-danger float-right" asp-validation-for="FeatureCategoryTitle"></span>
                    </div>
					</div>
                    <button type="submit" class="btn btn-success btn-block">افزودن دسته ویژگی</button>
                </form>
            </div>
        </div>
    </div>
</div>
