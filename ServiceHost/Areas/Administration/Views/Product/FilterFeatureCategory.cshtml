@model List<Eshop.Domain.Dtos.ProductFeaturesCategory.FilterProductFeaturesCategoryDto>

@{
	ViewData["Title"] = " دسته بندی ویژگی محصول ";
}


@section scripts
{
	<partial name="_AdminJqueryValidators" />

}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header"><i class="fa fa-plus"></i> افزودن دسته بندی ویژگی</div>
            <div class="card-body">
                <div class="row">
                    <div class="form-group col-lg-12">
                        <label>افزودن دسته بندی ویژگی</label>
                        <a class="btn btn-sm btn-success btn-block form-control"
                           asp-area="Administration" asp-controller="Product"
                           asp-action="CreateFeatureCategory">
                            افزودن دسته بندی ویژگی
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <div id="default-datatable_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                @if (Model != null && Model.Any())
                                {
                                    <table  class="table table-bordered dataTable" role="grid" aria-describedby="default-datatable_info">
                                        <thead>
                                            <tr role="row">
                                                <th class="sorting_asc">شناسه</th>
                                                <th class="sorting">نام دسته بندی</th>                                         
                                                <th class="sorting">تاریخ ایجاد</th>
                                                <th class="sorting">دستورات</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var category in Model)
                                            {
                                                <tr role="row" class="odd">
                                                    <td>@category.Id</td>
                                                    <td>@category.FeatureCategoryTitle</td>                                             
                                                    <td>@category.CreateDate</td>
                                                    <td>
                                                        <a asp-area="Administration" asp-controller="Product" asp-action="EditProductColor" class="btn btn-sm btn-warning">
                                                            ویرایش اطلاعات
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="alert alert-warning alert-dismissible mb-0" role="alert">
                                        <div class="alert-icon">
                                            <i class="fa fa-exclamation-triangle"></i>
                                        </div>
                                        <div class="alert-message text-dark">
                                            <span><strong>هشدار!</strong> هیچ اطلاعاتی یافت نشد</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <hr />
                        <hr />
                    </div>
                </div>
                <br />
            </div>
        </div>
    </div>
</div>