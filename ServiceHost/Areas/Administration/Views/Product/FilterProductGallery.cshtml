@model List<Eshop.Domain.Dtos.ProductGallery.FilterProductGallery>
@using Eshop.Application.Utilities
@using Microsoft.AspNetCore.Mvc.TagHelpers



@{
    ViewData["Title"] = "لیست گالری تصاویر";
}


@section scripts
{
    <partial name="_JqueryValidators" />
}

<div class="row pt-2 pb-2">
    <div class="col-sm-9">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Administration" asp-controller="Home" asp-action="Index">داشبورد</a></li>
            <li class="breadcrumb-item"><a href="javaScript:void();">مدیریت محصولات</a></li>
            <li class="breadcrumb-item"><a href="javaScript:void();">@ViewData["Title"]</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header"><i class="fa fa-plus"></i> افزودن گالری تصویر</div>
            <div class="card-body">

                <div class="row">

                    <div class="form-group col-lg-12">
                        <label>افزودن گالری تصویر</label>
                        <a class="btn btn-sm btn-success btn-block form-control"
                           asp-area="Administration" asp-controller="Product"
                           asp-action="CreateProductGallery" asp-route-productId="@ViewBag.productId">
                            افزودن گالری تصویر جدید
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <div id="default-datatable_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                @if (Model != null && Model.Any())
                                {
                                    <table id="default-datatable" class="table table-bordered dataTable" role="grid" aria-describedby="default-datatable_info">
                                        <thead>
                                            <tr role="row">
                                                <th class="sorting_asc">شناسه</th>
                                                <th class="sorting">تصویر</th>
                                                <th class="sorting">ترتیب اولویت</th>
                                                <th class="sorting">تاریخ ایجاد</th>
                                                <th class="sorting">دستورات</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var gallery in Model)
                                            {
                                                <tr role="row" class="odd">
                                                    <td>@gallery.Id</td>
                                                    <td class="sorting">
                                                        <img style="width: 50px; height: 50px;"
                                                             src="@(!string.IsNullOrEmpty(gallery.ImageName) ? PathExtension.ProductGalleryOrigin + gallery.ImageName : PathExtension.DefaultAvatar)" />
                                                    </td>

                                                    <td>@gallery.DisplayPriority</td>
                                                    <td>@gallery.CreateDate</td>
                                                    <td>
                                                        <a asp-area="Administration" asp-controller="Product" asp-action="EditProductGallery" asp-route-galleryId="@gallery.Id" class="btn btn-sm btn-warning">
                                                            ویرایش اطلاعات
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="alert alert-warning alert-dismissible mb-0" role="alert">
                                        <div class="alert-icon">
                                            <i class="fa fa-exclamation-triangle"></i>
                                        </div>
                                        <div class="alert-message text-dark">
                                            <span><strong>هشدار!</strong> هیچ اطلاعاتی یافت نشد</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="col-sm-12 col-md-12">
                    <div class="dataTables_info" id="default-datatable_info" role="status" aria-live="polite">نمایش تعداد 10 محصول در هر صفحه از تعداد کل : @Model.Count محصول</div>
                </div>
            </div>
        </div>
    </div>
</div>