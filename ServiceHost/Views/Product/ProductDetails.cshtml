                                <strong class="fs-3 fw-900">
                                    <del>@Model.Price.ToString("##,###")</del>
                                    <span class="text-muted font-14">تومان</span>
                                </strong>
                            </div>
                            <div class="text-center my-3 d-flex align-items-center justify-content-center">
                                <strong class="fs-3 fw-900 text-danger">
                                    @(Convert.ToInt32(Model.Price - ((Model.Price * Model.ProductDiscount.Percentage) / (double)100)).ToString("#,0"))
