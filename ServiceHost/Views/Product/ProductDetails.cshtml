                                </strong>
                            </div>
                        }
                        else
                        {
                            <div class="text-center my-3 d-flex align-items-center justify-content-center">
                                <strong class="fs-3 fw-900">@Model.Price.ToString("##,###")<span class="text-muted font-14">تومان</span></strong>
                            </div>
                        }

                        <div class="d-flex align-items-center justify-content-between">
                            <div class=" row align-items-center mb-2">
                                <div class="col-sm-12 mb-4">
                                    <div class="center">
                                        <div class="input-group">
                                            <button type="button" class="btn main-color-two-bg text-white fw-bold btn-number" data-type="minus" data-field="quant[2]">
                                                <span class="bi bi-dash"></span>
                                            </button>
                                            <input type="text" style="text-align: center;" name="quant[2]" class="form-control font-20 numberInput input-number" id="number_of_products_in_basket" value="1" min="1" max="1000">
                                            <button type="button" class="btn main-color-two-bg text-white fw-bold btn-number" data-type="plus" data-field="quant[2]">
                                                <span class="bi bi-plus fw-bold"></span>
                                            </button>
                                        </div>
                                        <p></p>
                                    </div>
                                </div>
                                @if (User.Identity.IsAuthenticated)
                                {

                                    <div class="col-md-12">
                                        <a id="submitOrderForm" class="w-100 shadow-sm text-center btn main-color-two-bg waves-effect waves-light">
                                            <i class="bi bi-cart-plus-fill font-18"></i>
                                            افزودن به سبد خرید
                                        </a>
                                    </div>
                                }
                                else
                                {
