                                        @foreach (var item in Model.ProductColors)
                                        {
                                            <input type="radio" class="btn-check" name="options" id="option1" checked="">
                                            <label class="btn " for="option1">
                                                <span style="background-color: @item.ColorCode;"></span>
                                                @item.ColorName
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
