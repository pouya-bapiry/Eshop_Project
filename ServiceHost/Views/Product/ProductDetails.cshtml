                                    @if (Model.ProductGalleries != null && Model.ProductGalleries.Any())
                                    {
                                        @foreach (var item in Model.ProductGalleries)
                                        {
                                            <div class="swiper-slide">
                                                <div class="swiper-zoom-container">
                                                    <img src="@(!string.IsNullOrEmpty(item.ImageName) ? PathExtension.ProductGalleryOrigin + item.ImageName : PathExtension.NoImage)"
                                                         alt="@item.Product.Title" title="@item.Product.Title" class="img-fluid">
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <img src="@(!string.IsNullOrEmpty(Model.Image) ? PathExtension.ProductOrigin + Model.Image : PathExtension.NoImage)"
                                             alt="@Model.Title" title="@Model.Title" class="img-fluid">
                                    }
                                </div>
                                <div class="swiper-button-next d-none d-lg-flex"></div>
                                <div class="swiper-button-prev d-none d-lg-flex"></div>
                            </div>
                            @if (Model.ProductDiscount != null && Model.ProductDiscount.ExpireDate >= DateTime.Now)
                            {
                                <div class="position-absolute z-3 top-0 start-0">
                                    <span class="badge bg-danger w-70-px h-40-px fw-normal font-14 d-flex align-items-center justify-content-center text-center rounded-circle ms-3 mt-3 ">@Model.ProductDiscount.Percentage %  تخفیف</span>
                                </div>
                            }
                        </div>
                        <div class="swiper product-gallery-thumb">
                            <div class="swiper-wrapper">
                                @if (Model.ProductGalleries != null && Model.ProductGalleries.Any())
                                {
                                    foreach (var item in Model.ProductGalleries)
                                    {
                                        <div class="swiper-slide">
                                            <img class="img-fluid" src="@(!string.IsNullOrEmpty(item.ImageName) ? PathExtension.ProductGalleryOrigin + item.ImageName : PathExtension.NoImage)"
                                                 alt="@item.Product.Title" title="@item.Product.Title">
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="swiper-slide">
                                        <img class="img-fluid" src="@(!string.IsNullOrEmpty(Model.Image) ? PathExtension.ProductOrigin + Model.Image : PathExtension.NoImage)"
                                             alt="@Model.Title" title="@Model.Title">
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
